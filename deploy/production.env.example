APP_ENV=production
NODE_ENV=production
APP_URL=https://resmen.loyiham.uz
BETTER_AUTH_URL=https://resmen.loyiham.uz
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
DATABASE_URL=postgresql://ravoq_app:REPLACE_PASSWORD@127.0.0.1:5432/ravoq
MAIL_MODE=smtp
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
MAIL_FROM=Resmen <noreply@resmen.loyiham.uz>
# Private S3-compatible bucket; images are served through authorization-aware routes.
STORAGE_DRIVER=s3
S3_ENDPOINT=REPLACE_HTTPS_ENDPOINT
S3_REGION=auto
S3_BUCKET=ravoq-images
S3_ACCESS_KEY_ID=REPLACE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_SECRET_KEY
# Single-server fallback: STORAGE_DRIVER=local and this persistent private directory.
UPLOAD_ROOT=/var/lib/ravoq/uploads
