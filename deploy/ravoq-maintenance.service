[Unit]
Description=Ravoq bounded expired-data maintenance
After=postgresql.service

[Service]
Type=oneshot
User=ravoq
Group=ravoq
WorkingDirectory=/srv/ravoq/current
EnvironmentFile=/etc/ravoq/maintenance.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --conditions=react-server --import=tsx scripts/maintenance.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ravoq
