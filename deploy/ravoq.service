[Unit]
Description=Resmen restaurant QR platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ravoq
Group=ravoq
WorkingDirectory=/srv/ravoq/current/.next/standalone
EnvironmentFile=/etc/ravoq/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3107
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ravoq /srv/ravoq/current/.next/standalone/.next/cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
